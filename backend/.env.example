DATABASE_URL=postgresql+psycopg://project_evidence:project_evidence@localhost:54329/project_evidence
CHECKPOINT_DATABASE_URL=postgresql://project_evidence:project_evidence@localhost:54329/project_evidence?sslmode=disable

# FakeLLMProvider is deterministic and requires no API key.
LLM_PROVIDER=fake

MAX_RETRIES_PER_STAGE=1
MAX_LLM_CALLS_PER_RUN=16
MAX_RUN_COST_USD=0.25
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=64

# Optional hosted inference. Put real secrets only in .env, never this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-2024-07-18
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=
OPENAI_MAX_RETRIES=2
OPENAI_TIMEOUT_SECONDS=60
OPENAI_INPUT_COST_PER_MILLION=0.15
OPENAI_OUTPUT_COST_PER_MILLION=0.60
OPENAI_INPUT_COST_PER_MILLION=0.15
OPENAI_OUTPUT_COST_PER_MILLION=0.60
